<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crane.cpb.mapper.CakeMapper">

    <resultMap id="BaseResultMap" type="com.crane.cpb.model.domain.Cake">
            <id property="cakeId" column="cake_id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="price" column="price" jdbcType="DECIMAL"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="merchantId" column="merchant_id" jdbcType="BIGINT"/>
            <result property="isDelete" column="is_delete" jdbcType="INTEGER"/>
            <result property="launchDate" column="launch_Date" jdbcType="DATE"/>
    </resultMap>

    <sql id="Base_Column_List">
        cake_id,name,price,
        description,merchant_id,is_delete
    </sql>
</mapper>
